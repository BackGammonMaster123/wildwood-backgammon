{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && auth.token.firebase.sign_in_provider !== 'anonymous'",
        "rs": { ".validate": "newData.isString() && newData.val().length < 1000" },
        "m": { "$k": { ".validate": "newData.isString() && newData.val().length < 200000" } },
        "g": { "$k": { ".validate": "newData.isString() && newData.val().length < 200000" } },
        "hg": { "$k": { ".validate": "newData.isString() && newData.val().length < 20000" } },
        "hq": { "$k": { ".validate": "newData.isString() && newData.val().length < 2000" } },
        "l": { "$k": { ".validate": "newData.isString() && newData.val().length < 2000" } },
        "rl": { "$k": { ".validate": "newData.isString() && newData.val().length < 2000" } },
        "$other": { ".validate": false }
      }
    }
  }
}
